# AIBuildX backend environment configuration
# Copy this file to .env and fill in production or local values.

# Backend server settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# File storage paths
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
JOB_DB_PATH=jobs.db

# Tekla integration endpoint
TEKLA_API_URL=http://localhost:8000

# Web UI / viewer hints
VIEWER_URL_BASE=http://localhost:5001

# Optional LLM / model orchestration settings
VLLM_HOST=http://127.0.0.1
VLLM_PORT=8000
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_PORT=11434
LLM_BACKEND=vllm
LLAMA_MODEL_PATH=/path/to/llama/model
LLM_TRAINING_VAULT=data/llm_training_data_vault.jsonl

# Security / database settings
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=sqlite:///aibuildx.db
